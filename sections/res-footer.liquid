{{ 'res-footer.css' | asset_url | stylesheet_tag }}

<footer class="res-footer">

  <!-- ── Top: menus + newsletter ──────────────────────── -->
  <div class="res-footer__top">

    <!-- Menus (desktop: colunas | mobile: accordions) -->
    <div class="res-footer__menus">
      {% for block in section.blocks %}
        {% if block.type == 'menu' %}
          {% assign menu = linklists[block.settings.menu] %}

          <!-- Desktop -->
          <div class="res-footer__menu-col" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <p class="res-footer__menu-heading">{{ block.settings.heading | upcase }}</p>
            {% endif %}
            {% if menu != blank %}
              <ul class="res-footer__menu-list">
                {% for link in menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>

          <!-- Mobile accordion -->
          <details class="res-footer__menu-details" {{ block.shopify_attributes }}>
            <summary class="res-footer__menu-summary">
              {{ block.settings.heading | upcase }}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            {% if menu != blank %}
              <ul class="res-footer__menu-accordion-list">
                {% for link in menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </details>

        {% endif %}
      {% endfor %}
    </div>

    <!-- Newsletter -->
    <div class="res-footer__newsletter">
      {% if section.settings.nl_title != blank %}
        <p class="res-footer__nl-title">{{ section.settings.nl_title | upcase }}</p>
      {% endif %}
      {% if section.settings.nl_subtitle != blank %}
        <p class="res-footer__nl-subtitle">{{ section.settings.nl_subtitle | upcase }}</p>
      {% endif %}

      {% form 'customer', id: "res-footer-nl-form-{{ section.id }}", class: 'res-footer__nl-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {% if form.posted_successfully? %}
          <p class="res-footer__nl-success">{{ section.settings.nl_success | default: 'Cadastro realizado com sucesso!' }}</p>
        {% else %}
          <div class="res-footer__nl-fields">
            <div class="res-footer__nl-field">
              <input
                type="text"
                name="contact[first_name]"
                placeholder="{{ section.settings.nl_label_name | default: 'NOME' }}"
                autocomplete="given-name"
              >
            </div>
            <div class="res-footer__nl-field">
              <input
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.nl_label_email | default: 'E-MAIL' }}"
                autocomplete="email"
                aria-required="true"
                required
                {% if form.errors %}aria-invalid="true"{% endif %}
              >
            </div>
          </div>

          {% if form.errors %}
            <p style="font-size:11px;opacity:0.7;margin-bottom:10px;">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {% endif %}

          <button type="submit" class="res-footer__nl-btn">
            {{ section.settings.nl_btn_label | default: 'CADASTRAR' | upcase }}
          </button>
        {% endif %}
      {% endform %}
    </div>

  </div>

  <!-- ── Brand (logo ou nome) ─────────────────────────── -->
  <div class="res-footer__brand">
    {% if section.settings.brand_image != blank %}
      <img
        src="{{ section.settings.brand_image | image_url: width: 400 }}"
        alt="{{ shop.name }}"
        loading="lazy"
        width="{{ section.settings.brand_image.width }}"
        height="{{ section.settings.brand_image.height }}"
      >
    {% else %}
      <span class="res-footer__brand-text">{{ shop.name | upcase }}</span>
    {% endif %}
  </div>

  <!-- ── Bottom: copyright ────────────────────────────── -->
  {% if section.settings.copy_text != blank %}
    <div class="res-footer__bottom">
      <p class="res-footer__copy">{{ section.settings.copy_text }}</p>
    </div>
  {% endif %}

</footer>

{% schema %}
{
  "name": "Footer Afago",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Marca"
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Logo (deixe vazio para exibir o nome da loja)"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "nl_title",
      "label": "Título",
      "default": "Inscreva-se em nossa newsletter"
    },
    {
      "type": "text",
      "id": "nl_subtitle",
      "label": "Subtítulo",
      "default": "E receba acesso antecipado aos lançamentos e promoções exclusivas!"
    },
    {
      "type": "text",
      "id": "nl_label_name",
      "label": "Placeholder — Nome",
      "default": "NOME"
    },
    {
      "type": "text",
      "id": "nl_label_email",
      "label": "Placeholder — E-mail",
      "default": "E-MAIL"
    },
    {
      "type": "text",
      "id": "nl_btn_label",
      "label": "Texto do botão",
      "default": "CADASTRAR"
    },
    {
      "type": "text",
      "id": "nl_success",
      "label": "Mensagem de sucesso",
      "default": "Cadastro realizado com sucesso!"
    },
    {
      "type": "header",
      "content": "Rodapé"
    },
    {
      "type": "text",
      "id": "copy_text",
      "label": "Texto de copyright",
      "default": "Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título do menu",
          "default": "Menu"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "main-menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Afago",
      "blocks": [
        {
          "type": "menu",
          "settings": { "heading": "Minha Conta" }
        },
        {
          "type": "menu",
          "settings": { "heading": "Institucional" }
        },
        {
          "type": "menu",
          "settings": { "heading": "Suporte" }
        }
      ]
    }
  ]
}
{% endschema %}
